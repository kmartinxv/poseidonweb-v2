# Poseidon Vet – Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API base URL (leave empty to use local mock data)
# Example: https://api.poseidonvet.com/v1
VITE_API_URL=

# Google Maps Embed API key (for Contact page map)
VITE_MAPS_KEY=

# Optional: Mpesa Daraja API (handled server-side, but reference key here)
# VITE_MPESA_SHORTCODE=
