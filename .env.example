# Poseidon Vet – Environment Variables
# Copy this file to .env.local and fill in your values.
# The shop/blog/admin backend (/api) doesn't need a base URL here — it's
# always same-origin (dev: Vite proxy, prod: same domain). See api/README.md.

# Client Portal API — the separate Laravel practice-management system
# (poseidon_vet_lv). Defaults to http://localhost:8000/api for local dev.
VITE_PORTAL_API_URL=

# Google Maps Embed API key (for Contact page map)
VITE_MAPS_KEY=
