# Copy this file to public_html/.htaccess on HostGator (alongside the built
# frontend files and the /api folder). Makes Vue Router's client-side routes
# (e.g. /blog/some-post, /shop, /admin) work on direct load/refresh, while
# leaving real files and the PHP API untouched.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is (images, CSS, JS, /api/*.php …)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite API requests
  RewriteRule ^api/ - [L]

  # Everything else falls back to index.html so Vue Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>
